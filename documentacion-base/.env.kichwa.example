# Incorporar estas variables al .env existente; no reemplazar APP_KEY.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=base_kichwa
DB_USERNAME=usuario_kichwa
DB_PASSWORD=

# Evitan depender de tablas genéricas de Laravel si no las utiliza:
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Sólo para la creación explícita del primer administrador:
KICHWA_ADMIN_NOMBRE=
KICHWA_ADMIN_EMAIL=
KICHWA_ADMIN_PASSWORD=
