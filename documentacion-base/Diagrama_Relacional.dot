digraph G {
graph [rankdir=LR, bgcolor="#f5f8fc", pad="0.45", nodesep="0.6", ranksep="1.4", splines=spline, fontname="DejaVu Sans", labelloc=t, label="BASE KICHWA · MODELO RELACIONAL\n14 tablas · PostgreSQL · Basado en MER v3\nPK = clave primaria | FK = clave foránea | ? = admite NULL\nLas vistas calculadas se describen en el recuadro de vistas", fontsize=26];
node [shape=plain,fontname="DejaVu Sans"];
edge [color="#8799b0",penwidth=1.25,arrowsize=0.7,fontname="DejaVu Sans",fontsize=12];
"usuarios" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#205279"><FONT COLOR="white"><B>USUARIOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_usuario" ALIGN="LEFT">id_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="cedula_usuario" ALIGN="LEFT">cedula_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(20) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="nombre_usuario" ALIGN="LEFT">nombre_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="correo_usuario" ALIGN="LEFT">correo_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="contrasena_usuario" ALIGN="LEFT">contrasena_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="rol_usuario" ALIGN="LEFT">rol_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="estado_usuario" ALIGN="LEFT">estado_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="remember_token" ALIGN="LEFT">remember_token</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(100) ?</FONT></TD></TR></TABLE>>];
"niveles" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#344d69"><FONT COLOR="white"><B>NIVELES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_nivel" ALIGN="LEFT">id_nivel</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="nombre_nivel" ALIGN="LEFT">nombre_nivel</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="descripcion_nivel" ALIGN="LEFT">descripcion_nivel</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="orden_nivel" ALIGN="LEFT">orden_nivel</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">integer</FONT></TD></TR></TABLE>>];
"modulos" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#344d69"><FONT COLOR="white"><B>MODULOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_modulo" ALIGN="LEFT">id_modulo</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_nivel" ALIGN="LEFT">id_nivel</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="nombre_modulo" ALIGN="LEFT">nombre_modulo</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="descripcion_modulo" ALIGN="LEFT">descripcion_modulo</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="orden_modulo" ALIGN="LEFT">orden_modulo</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">integer</FONT></TD></TR></TABLE>>];
"unidades" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#344d69"><FONT COLOR="white"><B>UNIDADES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_unidad" ALIGN="LEFT">id_unidad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_modulo" ALIGN="LEFT">id_modulo</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="titulo_unidad" ALIGN="LEFT">titulo_unidad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(180)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="objetivo_unidad" ALIGN="LEFT">objetivo_unidad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="orden_unidad" ALIGN="LEFT">orden_unidad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">integer</FONT></TD></TR></TABLE>>];
"usuarios_niveles" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#205279"><FONT COLOR="white"><B>USUARIOS_NIVELES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_usuario_nivel" ALIGN="LEFT">id_usuario_nivel</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_usuario" ALIGN="LEFT">id_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_nivel" ALIGN="LEFT">id_nivel</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR></TABLE>>];
"progreso" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#20786e"><FONT COLOR="white"><B>PROGRESO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_progreso" ALIGN="LEFT">id_progreso</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_usuario" ALIGN="LEFT">id_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_unidad" ALIGN="LEFT">id_unidad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="fecha_inicio_progreso" ALIGN="LEFT">fecha_inicio_progreso</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="fecha_actualizacion_progreso" ALIGN="LEFT">fecha_actualizacion_progreso</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">timestamptz</FONT></TD></TR></TABLE>>];
"temas" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#344d69"><FONT COLOR="white"><B>TEMAS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_tema" ALIGN="LEFT">id_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_unidad" ALIGN="LEFT">id_unidad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="tipo_tema" ALIGN="LEFT">tipo_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="titulo_tema" ALIGN="LEFT">titulo_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(180)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="contenido_tema" ALIGN="LEFT">contenido_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="orden_tema" ALIGN="LEFT">orden_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">integer</FONT></TD></TR></TABLE>>];
"actividades" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#344d69"><FONT COLOR="white"><B>ACTIVIDADES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_actividad" ALIGN="LEFT">id_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_unidad" ALIGN="LEFT">id_unidad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="tipo_actividad" ALIGN="LEFT">tipo_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="enunciado_actividad" ALIGN="LEFT">enunciado_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="elementos_actividad" ALIGN="LEFT">elementos_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="zonas_actividad" ALIGN="LEFT">zonas_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="recurso_actividad" ALIGN="LEFT">recurso_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(500) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="solucion_actividad" ALIGN="LEFT">solucion_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="orden_actividad" ALIGN="LEFT">orden_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">integer</FONT></TD></TR></TABLE>>];
"respuestas_actividad" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#20786e"><FONT COLOR="white"><B>RESPUESTAS_ACTIVIDAD</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_respuesta_actividad" ALIGN="LEFT">id_respuesta_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_usuario" ALIGN="LEFT">id_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_actividad" ALIGN="LEFT">id_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="respuesta_actividad" ALIGN="LEFT">respuesta_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="acierto_actividad" ALIGN="LEFT">acierto_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="retroalimentacion_actividad" ALIGN="LEFT">retroalimentacion_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="fecha_respuesta_actividad" ALIGN="LEFT">fecha_respuesta_actividad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">timestamptz</FONT></TD></TR></TABLE>>];
"evaluaciones" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#71508b"><FONT COLOR="white"><B>EVALUACIONES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_evaluacion" ALIGN="LEFT">id_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_unidad" ALIGN="LEFT">id_unidad</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="titulo_evaluacion" ALIGN="LEFT">titulo_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(180)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="tipo_evaluacion" ALIGN="LEFT">tipo_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(30)</FONT></TD></TR></TABLE>>];
"preguntas" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#71508b"><FONT COLOR="white"><B>PREGUNTAS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_pregunta" ALIGN="LEFT">id_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_evaluacion" ALIGN="LEFT">id_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="tipo_pregunta" ALIGN="LEFT">tipo_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="enunciado_pregunta" ALIGN="LEFT">enunciado_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="elementos_pregunta" ALIGN="LEFT">elementos_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="zonas_pregunta" ALIGN="LEFT">zonas_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="recurso_pregunta" ALIGN="LEFT">recurso_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(500) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="solucion_pregunta" ALIGN="LEFT">solucion_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="puntaje_pregunta" ALIGN="LEFT">puntaje_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">numeric(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="orden_pregunta" ALIGN="LEFT">orden_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">integer</FONT></TD></TR></TABLE>>];
"intentos_evaluacion" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#71508b"><FONT COLOR="white"><B>INTENTOS_EVALUACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_intento" ALIGN="LEFT">id_intento</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_usuario" ALIGN="LEFT">id_usuario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_evaluacion" ALIGN="LEFT">id_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="numero_intento" ALIGN="LEFT">numero_intento</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="fecha_inicio_intento" ALIGN="LEFT">fecha_inicio_intento</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="fecha_fin_intento" ALIGN="LEFT">fecha_fin_intento</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">timestamptz ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="estado_intento" ALIGN="LEFT">estado_intento</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(30)</FONT></TD></TR></TABLE>>];
"respuestas_evaluacion" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#71508b"><FONT COLOR="white"><B>RESPUESTAS_EVALUACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_respuesta_evaluacion" ALIGN="LEFT">id_respuesta_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_intento" ALIGN="LEFT">id_intento</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK</FONT></TD><TD PORT="id_pregunta" ALIGN="LEFT">id_pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">FK*</FONT></TD><TD PORT="id_evaluacion" ALIGN="LEFT">id_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="respuesta_evaluacion" ALIGN="LEFT">respuesta_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="puntaje_respuesta_evaluacion" ALIGN="LEFT">puntaje_respuesta_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">numeric(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="fecha_respuesta_evaluacion" ALIGN="LEFT">fecha_respuesta_evaluacion</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">timestamptz</FONT></TD></TR></TABLE>>];
"diccionario" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#344d69"><FONT COLOR="white"><B>DICCIONARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">PK</FONT></TD><TD PORT="id_diccionario" ALIGN="LEFT">id_diccionario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="palabra_kichwa_diccionario" ALIGN="LEFT">palabra_kichwa_diccionario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#20786e">&#160;</FONT></TD><TD PORT="palabra_espanol_diccionario" ALIGN="LEFT">palabra_espanol_diccionario</TD><TD ALIGN="LEFT"><FONT COLOR="#65758a">varchar(250)</FONT></TD></TR></TABLE>>];
