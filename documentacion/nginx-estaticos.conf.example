# Fragmento para incluir dentro del server que sirve frontend/dist.
# Configure root al directorio absoluto de frontend/dist y mantenga su proxy/API.
# No usar para el servidor Vite de desarrollo.
gzip on;
gzip_vary on;
gzip_min_length 512;
gzip_comp_level 5;
gzip_types text/css application/javascript application/json image/svg+xml;
location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
}
location = /index.html {
    add_header Cache-Control "no-cache";
    # Copiar dist/csp-report-only.nginx.conf de ESTA compilacion a esta ruta.
    # Conservar las demas cabeceras del servidor real (incluida su herencia).
    include /etc/nginx/snippets/yachay-csp-report-only.conf;
}
location / {
    try_files $uri $uri/ /index.html;
}
