# Fragmento para incluir dentro del server que sirve frontend/dist.
# Configure root al directorio absoluto de frontend/dist y mantenga su proxy/API.
# No usar para el servidor Vite de desarrollo.
gzip on;
gzip_vary on;
gzip_min_length 512;
gzip_comp_level 5;
gzip_types text/css application/javascript application/json image/svg+xml;
location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
}
location = /index.html {
    add_header Cache-Control "no-cache";
}
location / {
    try_files $uri $uri/ /index.html;
}
