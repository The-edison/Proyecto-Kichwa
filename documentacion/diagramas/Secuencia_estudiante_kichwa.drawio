        <mxCell id="39" value="15. Mostrar aviso y permitir otra búsqueda" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1">
