          </mxGeometry>
        </mxCell>
        <mxCell id="41" value="No es un traductor automático de frases. El diccionario actual almacena equivalencias kichwa–español; no se usa el antiguo glosario como fuente independiente." style="shape=note;html=1;whiteSpace=wrap;size=15;fillColor=#F5F3FF;strokeColor=#E4DFF7;fontColor=#5B5780;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="1960" width="1645" height="72" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Los cambios de publicación actualizan el catálogo; el avance se calcula con recursos accesibles y conserva los resultados históricos de versiones anteriores. La publicación de testimonios permanece deshabilitada hasta habilitar el flujo de Intermedio." style="shape=note;html=1;whiteSpace=wrap;size=15;fillColor=#F5F3FF;strokeColor=#E4DFF7;fontColor=#5B5780;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="2072" width="1645" height="72" as="geometry" />
        </mxCell>
        <mxCell id="49" value="alt" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="38" y="1588" width="68" height="26" as="geometry" />
        </mxCell>
        <mxCell id="50" value="[Existen términos]" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="117" y="1588" width="1551" height="30" as="geometry" />
        </mxCell>
        <mxCell id="52" value="[Sin coincidencias]" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="42" y="1746" width="1621" height="32" as="geometry" />
        </mxCell>
        <mxCell id="54" value="loop" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="26" y="1080" width="68" height="26" as="geometry" />
        </mxCell>
        <mxCell id="55" value="[Buscar vocabulario o cambiar de dirección]" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="105" y="1080" width="1575" height="30" as="geometry" />
        </mxCell>
        <mxCell id="56" value="¹ Servicios internos de Laravel: no son un servidor adicional. Flecha continua = solicitud; discontinua = respuesta. Los fragmentos opt / alt / loop muestran condiciones, alternativas y repetición." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="2239" width="1645" height="55" as="geometry" />
        </mxCell>
