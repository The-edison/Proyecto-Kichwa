="1" parent="1"><mxGeometry x="859" y="4385" width="1022" height="60" as="geometry"/></mxCell><mxCell id="93" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1E1B4B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845" y="4450" as="sourcePoint"/><mxPoint x="1895" y="4450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="94" value="42. Callback /auth/google/callback&lt;br&gt;Código y perfil de Google" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="859" y="4473" width="1022" height="60" as="geometry"/></mxCell><mxCell id="95" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#5B5780;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="4538" as="sourcePoint"/><mxPoint x="845" y="4538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="96" value="43. Validar state, pestaña, correo verificado&lt;br&gt;y reglas de vinculación" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="4561" width="246" height="60" as="geometry"/></mxCell><mxCell id="97" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1E1B4B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845" y="4626" as="sourcePoint"/><mxPoint x="845" y="4650" as="targetPoint"/><Array as="points"><mxPoint x="920" y="4626"/><mxPoint x="920" y="4650"/></Array></mxGeometry></mxCell><mxCell id="98" value="44. Leer / crear estudiante / vincular cuenta&lt;br&gt;según intención; sin elevar roles" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="859" y="4661" width="672" height="60" as="geometry"/></mxCell><mxCell id="99" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1E1B4B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845" y="4726" as="sourcePoint"/><mxPoint x="1545" y="4726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="100" value="45. Cuenta correspondiente" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="859" y="4749" width="672" height="60" as="geometry"/></mxCell><mxCell id="101" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#5B5780;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1545" y="4814" as="sourcePoint"/><mxPoint x="845" y="4814" as="targetPoint"/></mxGeometry></mxCell><mxCell id="102" value="46. Redirigir al rol o Mi cuenta&lt;br&gt;con confirmación / error" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="509" y="4837" width="322" height="60" as="geometry"/></mxCell><mxCell id="103" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#5B5780;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845" y="4902" as="sourcePoint"/><mxPoint x="495" y="4902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="104" value="47. Activar o desactivar modo oscuro" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="159" y="5028" width="322" height="60" as="geometry"/></mxCell><mxCell id="105" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1E1B4B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="5093" as="sourcePoint"/><mxPoint x="495" y="5093" as="targetPoint"/></mxGeometry></mxCell><mxCell id="106" value="48. Guardar localStorage: yachay-theme:admin&lt;br&gt;y aplicar variables CSS" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="5116" width="246" height="60" as="geometry"/></mxCell><mxCell id="107" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1E1B4B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="5181" as="sourcePoint"/><mxPoint x="495" y="5205" as="targetPoint"/><Array as="points"><mxPoint x="570" y="5181"/><mxPoint x="570" y="5205"/></Array></mxGeometry></mxCell><mxCell id="108" value="49. Actualizar interfaz de este rol&lt;br&gt;sin cambiar el tema del otro" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="159" y="5216" width="322" height="60" as="geometry"/></mxCell><mxCell id="109" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#5B5780;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="5281" as="sourcePoint"/><mxPoint x="145" y="5281" as="targetPoint"/></mxGeometry></mxCell><mxCell id="110" value="Tema: sin solicitudes a API ni escrituras PostgreSQL. Primera visita respeta prefers-color-scheme; se aplica antes del render. Mi cuenta recuerda el rol en sessionStorage; eventos de otro rol se ignoran. Menús agrupados, Escape y navegación por teclado." style="shape=note;html=1;whiteSpace=wrap;size=15;fillColor=#F5F3FF;strokeColor=#E4DFF7;fontColor=#5B5780;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="5404" width="1995" height="72" as="geometry"/></mxCell><mxCell id="118" value="alt" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="1076" width="68" height="26" as="geometry"/></mxCell><mxCell id="119" value="[Contraseñas válidas y distintas]" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="117" y="1076" width="1901" height="30" as="geometry"/></mxCell><mxCell id="121" value="[Contraseña actual incorrecta o datos inválidos]" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="1850" width="1971" height="32" as="geometry"/></mxCell><mxCell id="123" value="opt" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="26" y="732" width="68" height="26" as="geometry"/></mxCell><mxCell id="124" value="[Cambiar contraseña actual o inicial]" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="105" y="732" width="1925" height="30" as="geometry"/></mxCell><mxCell id="126" value="opt" style="text;html=1;whiteSpace=