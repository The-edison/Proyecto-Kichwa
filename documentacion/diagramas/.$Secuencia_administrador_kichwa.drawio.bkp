a]" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="105" y="3407" width="1575" height="30" as="geometry"/></mxCell><mxCell id="111" value="¹ Servicios internos de Laravel: no son un servidor adicional. Flecha continua = solicitud; discontinua = respuesta. Los fragmentos opt / alt / loop muestran condiciones, alternativas y repetición." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="4549" width="1645" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram>
