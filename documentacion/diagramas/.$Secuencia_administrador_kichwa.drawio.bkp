28" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="13. Mostrar error; no abrir el panel" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="159" y="1951" width="322" height="60" as="geometry"/></mxCell><mxCell id="37" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#5B5780;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="2016" as="sourcePoint"/><mxPoint x="145" y="2016" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="La autenticación utiliza correo, no cédula. Una pestaña nueva o duplicada exige iniciar sesión; no hereda el acceso de otra pestaña." style="shape=note;html=1;whiteSpace=wrap;size=15;fillColor=#F5F3FF;strokeColor=#E4DFF7;fontColor=#5B5780;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="2139" width="1645" height="68" as="geometry"/></mxCell><mxCell id="39" value="14. Cerrar sesión / detectar inactividad" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="159" y="2250" width="322" height="60" as="geometry"/></mxCell><mxCell id="40" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1E1B4B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="2315" as="sourcePoint"/><mxPoint x="495" y="2315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="41" value="15. POST /api/auth/logout" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E1B4B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="509" y="2338" width=