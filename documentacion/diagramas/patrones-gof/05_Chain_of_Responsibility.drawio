ll id="gof5-edge-9" value="" edge="1" parent="1" source="gof5-authenticate" target="gof5-auth-fail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;strokeColor=#334B5E;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;dashed=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gof5-edge-9-label" value="sin identidad" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=#FFFFFF;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="2045.5" y="992" width="159" height="36" as="geometry"/></mxCell><mxCell id="gof5-edge-10" value="" edge="1" parent="1" source="gof5-active" target="gof5-active-fail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;strokeColor=#334B5E;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;dashed=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gof5-edge-10-label" value="control incumplido" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=#FFFFFF;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="2018" y="1702" width="214" height="36" as="geometry"/></mxCell><mxCell id="gof5-edge-11" value="" edge="1" parent="1" source="gof5-role" target="gof5-role-fail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5555555555555556;exitPerimeter=0;entryPerimeter=0;strokeColor=#334B5E;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;dashed=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gof5-edge-11-label" value="rol incorrecto" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=#FFFFFF;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="2040" y="2052" width="170" height="36" as="geometry"/></mxCell><mxCell id="gof5-chain-note" value="Orden de ruta resuelto con el Router
de la instalación actual de Yachay.

La subcadena SPA se ejecuta dentro
de Sanctum; no se añade al mismo
nivel que los demás manejadores.

Se omiten los middleware globales
y el retorno de la respuesta para
centrar la lectura en esta ruta." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=25;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="100" y="1110" width="700" height="550" as="geometry"/></mxCell><mxCell id="gof5-scope" value="Orden verificado: Sanctum → Authenticate → SubstituteBindings → CuentaActiva → RequireRole → acción.
La cadena es específica de esta ruta administrativa; no todas las rutas de Yachay usan estos controles." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=23;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="70" y="2685" width="2960" height="90" as="geometry"/></mxCell><mxCell id="gof5-notation" value="Flujo: flechas verticales = continuación; flechas a la derecha = interrupción; dependencia lateral = detalle de la subcadena SPA." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="70" y="2793" width="2960" height="36" as="geometry"/></mxCell><mxCell id="gof5-legend-text-own" value="Yachay" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="122" y="2854" width="488" height="38" as="geometry"/></mxCell><mxCell id="gof5-legend-text-laravel" value="Laravel / Sanctum" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="662" y="2854" width="488" height="38" as="geometry"/></mxCell><mxCell id="gof5-legend-text-external" value="Dependencia externa" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="1202" y="2854" width="618" height="38" as="geometry"/></mxCell><mxCell id="gof5-legend-text-neutral" value="Flujo / explicación" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="1872" y="2854" width="488" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
