;dashed=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gof4-edge-10-label" value="no autoriza" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=#FFFFFF;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="856.5" y="1772" width="137" height="36" as="geometry"/></mxCell><mxCell id="gof4-edge-11" value="" edge="1" parent="1" source="gof4-fails" target="gof4-invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;strokeColor=#334B5E;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;dashed=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gof4-edge-11-label" value="con errores" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=#FFFFFF;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="2056.5" y="1772" width="137" height="36" as="geometry"/></mxCell><mxCell id="gof4-sequence-title" value="Secuencia común de validateResolved() · Camino principal; se omite la rama de precognición" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="100" y="1370" width="2900" height="60" as="geometry"/></mxCell><mxCell id="gof4-scope" value="El trait aporta validateResolved(); FormRequest lo incorpora, y las solicitudes propias heredan de FormRequest.
Las reglas concretas se obtienen mediante validationRules(); authorize() es invocado por passesAuthorization()." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=23;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="70" y="2175" width="2960" height="90" as="geometry"/></mxCell><mxCell id="gof4-notation" value="UML: triángulo vacío = herencia; dependencia «usa trait» = incorporación del trait. La franja inferior representa flujo, no clases nuevas." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="70" y="2283" width="2960" height="36" as="geometry"/></mxCell><mxCell id="gof4-legend-text-own" value="Yachay" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="122" y="2344" width="488" height="38" as="geometry"/></mxCell><mxCell id="gof4-legend-text-laravel" value="Laravel / Sanctum" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="662" y="2344" width="488" height="38" as="geometry"/></mxCell><mxCell id="gof4-legend-text-external" value="Dependencia externa" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="1202" y="2344" width="618" height="38" as="geometry"/></mxCell><mxCell id="gof4-legend-text-neutral" value="Flujo / explicación" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="1872" y="2344" width="488" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
