Las reglas concretas se obtienen mediante validationRules(); authorize() es invocado por passesAuthorization()." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=23;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="70" y="2175" width="2960" height="90" as="geometry"/></mxCell><mxCell id="gof4-notation" value="UML: triángulo vacío = herencia; dependencia «usa trait» = incorporación del trait. La franja inferior representa flujo, no clases nuevas." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="70" y="2283" width="2960" height="36" as="geometry"/></mxCell><mxCell id="gof4-legend-text-own" value="Yachay" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="122" y="2344" width="488" height="38" as="geometry"/></mxCell><mxCell id="gof4-legend-text-laravel" value="Laravel / Sanctum" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="662" y="2344" width="488" height="38" as="geometry"/></mxCell><mxCell id="gof4-legend-text-external" value="Dependencia externa" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#182B3A;" vertex="1" parent="1" ><mxGeometry x="1202" y="2344" width="618" height="38" as="geometry"/></mxCell><mxCell id="gof4-legend-text-neutral" value="Flujo / explicación" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;spacing=0;fillColor=none;