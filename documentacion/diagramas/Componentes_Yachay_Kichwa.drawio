="830" height="80" as="geometry"/></mxCell><mxCell id="data" value="" style="rounded=1;arcSize=3;fillColor=#F7F9FC;strokeColor=#C8D2DF;strokeWidth=1;dashed=1;dashPattern=6 5;" vertex="1" parent="1" ><mxGeometry x="55" y="1680" width="1940" height="245" as="geometry"/></mxCell><mxCell id="data-title" value="ACCESO A DATOS E INFRAESTRUCTURA COMPARTIDA" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#566578;fontStyle=1;spacing=0;" vertex="1" parent="1" ><mxGeometry x="80" y="1692" width="1890" height="35" as="geometry"/></mxCell><mxCell id="orm" value="&lt;b&gt;Persistencia de aplicación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Modelos Eloquent + Query Builder / DB&lt;br&gt;Usuario · Nivel · Modulo · Unidad · Tema&lt;br&gt;Actividad · EvaluacionKichwa · Pregunta&lt;br&gt;Intentos · respuestas · Diccionario · Testimonial&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8DCE5;strokeColor=#343A40;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;spacingLeft=22;spacingRight=14;spacingTop=12;spacingBottom=12;" vertex="1" parent="1" ><mxGeometry x="100" y="1740" width="550" height="160" as="geometry"/></mxCell><mxCell id="orm-tab0" value="" style="rounded=0;fillColor=#F8DCE5;strokeColor=#343A40;strokeWidth=3;" vertex="1" parent="1" ><mxGeometry x="84" y="1770" width="34" height="18" as="geometry"/></mxCell><mxCell id="orm-tab1" value="" style="rounded=0;fillColor=#F8DCE5;strokeColor=#343A40;strokeWidth=3;" vertex="1" parent="1" ><mxGeometry x="84" y="1852" width="34" height="18" as="geometry"/></mxCell><mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Esquema construido por migraciones&lt;br&gt;Tablas · vistas · funciones · triggers&lt;br&gt;Sesiones · dominio · historial · recompensas&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8DCE5;strokeCol