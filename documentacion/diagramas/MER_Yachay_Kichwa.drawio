<mxCell id="c292" value="&lt;b&gt;Leyenda:&lt;/b&gt; PK = clave primaria (subrayada) · FK = clave foránea · NN = NOT NULL · NULL = admite nulos.&lt;br&gt;UNIQUE con varias columnas representa una combinación única. JSON/JSONB conserva su estructura como atributo.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#14304A;fontSize=15;" vertex="1" parent="1" ><mxGeometry x="55" y="3115" width="1990" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram>
