ex="1" connectable="0" parent="r5"><mxGeometry x="-0.88" y="-16" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r5t" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r5"><mxGeometry x="0.88" y="-16" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;jettySize=28;html=1;strokeColor=#555555;strokeWidth=1.4;endArrow=block;endFill=0;dashed=1;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="Usuario" target="MustVerifyEmail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;jettySize=28;html=1;strokeColor=#555555;strokeWidth=1.4;endArrow=block;endFill=0;dashed=0;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="Usuario" target="Authenticatable"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="670"/><mxPoint x="55" y="1580"/></Array></mxGeometry></mxCell><mxCell id="contract" value="&lt;b&gt;Autenticación vigente&lt;/b&gt;&lt;br&gt;config/auth.php usa Usuario.&lt;br&gt;Usuario implementa MustVerifyEmail (contrato Laravel)&lt;br&gt;y utiliza HasApiTokens, HasFactory, MustVerifyEmail&lt;br&gt;y Notifiable como traits." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="90" y="1270" width="630" height="170" as="geometry"/></mxCell><mxCell id="constraints" value="&lt;b&gt;Restricciones de dominio&lt;/b&gt;&lt;br&gt;UsuarioNivel: único (id_usuario, id_nivel).&lt;br&gt;ProgresoUnidad: único (id_usuario, id_unidad).&lt;br&gt;Testimonial: único (usuario_id, language).&lt;br&gt;usuario_id es nullable por compatibilidad;&lt;br&gt;el flujo actual de opiniones utiliza Usuario.&lt;br&gt;&lt;br&gt;Los roles activos se guardan en rol_usuario;&lt;br&gt;no hay subclases Estudiante y Administrador." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1600" y="1330" width="510" height="270" as="geometry"/></mxCell><mxCell id="notes" value="Usuario, Nivel y Unidad se repiten como referencias de otras páginas. Los extremos de las asociaciones muestran cardinalidades del esquema.&lt;br&gt;La relación Testimonial.usuario() es BelongsTo; su autor es opcional en el esquema. Las reglas de publicación se aplican en el controlador." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="1760" width="2140" height="100" as="geometry"/></mxCell><mxCell id="legend" value="UML: + público / atributo dinámico de Eloquent · # protegido · ? tipo nullable · {static} método estático · {oculto} excluido de serialización.&lt;br&gt;Línea: asociación · Triángulo vacío: herencia · Flecha discontinua: dependencia · 1 / 0..1 / 0..*: multiplicidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1872" width="2140" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="attempts" name="03 · Práctica y evaluaciones"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageSc