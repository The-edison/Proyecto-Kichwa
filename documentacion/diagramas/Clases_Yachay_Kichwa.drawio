ly=Helvetica;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="IntentoEvaluacion" target="RespuestaEvaluacion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r6s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r6"><mxGeometry x="-0.88" y="-16" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r6t" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r6"><mxGeometry x="0.88" y="-16" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r7" value="se responde en" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;jettySize=28;html=1;strokeColor=#555555;strokeWidth=1.4;endArrow=none;endFill=0;dashed=0;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Pregunta" target="RespuestaEvaluacion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r7s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r7"><mxGeometry x="-0.88" y="-16" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r7t" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r7"><mxGeometry x="0.88" y="-16" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Reglas de intentos y respuestas&lt;/b&gt;&lt;br&gt;Un intento pertenece a un usuario y una evaluación.&lt;br&gt;Único (id_usuario, id_evaluacion, numero_intento).&lt;br&gt;Como máximo un intento en curso por usuario/evaluación.&lt;br&gt;RespuestaEvaluacion: único (id_intento, id_pregunta).&lt;br&gt;RespuestaActividad: único (id_usuario, clave_envio).&lt;br&gt;&lt;br&gt;La evaluación del intento y de la pregunta debe coincidir&lt;br&gt;con RespuestaEvaluacion.id_evaluacion." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="90" y="1420" width="620" height="310" as="geometry"/></mxCell><mxCell id="xp" value="&lt;b&gt;XP y recompensas&lt;/b&gt;&lt;br&gt;DominioLecciones consulta y actualiza recompensas&lt;br&gt;con Query Builder. No existe una clase Recompensa&lt;br&gt;en app/Models; por ello no se inventa un modelo.&lt;br&gt;Las funciones y triggers de PostgreSQL también participan." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="90" y="1810" width="620" height="190" as="geometry"/></mxCell><mxCell id="notes" value="Usuario se muestra resumido; su definición completa está en la página 02. Todas las clases persistentes de esta página heredan de Eloquent (Usuario vía Authenticatable).&lt;br&gt;Las asociaciones son estructurales, aunque la mayoría de estos modelos no declare métodos belongsTo()/hasMany(); el código usa IDs y consultas." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="2050" width="2160" height="100" as="geometry"/></mxCell><mxCell id="legend" value="UML: + público / atributo dinámico de Eloquent · # protegido · ? tipo nullable · {static} método estático · {oculto} excluido de serialización.&lt;br&gt;Línea: asociación · Triángulo vacío: herencia · Flecha discontinua: dependencia · 1 / 0..1 / 0..*: multiplicidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="2162" width="2160" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="services" name="04 · Servicios de dominio"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="2080" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagrama de clases · Servicios de dominio" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=29;fontStyle=1;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="2320" height="46" as="geometry"/></mxCell><mxCell id="subtitle" value="04 / Operaciones reales del sistema y dependencias entre servicios" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="91" width="2320" height="46" as="geometry"/></mxCell><mxCell id="DominioLecciones" value="" style="group" vertex="1" parent="1"><mxGeometry x="80" y="240" width="700" height="365" as="geometry"/></mxCell><mxCell id="DominioLecciones-h" value="&lt;font style=&quot;font-size:12px&quot;&gt;«servicio»&lt;/font&gt;&lt;br&gt;&lt;b&gt;DominioLecciones&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#737373;strokeWidth=1.3;fontFamily=Helvetica;fillColor=#E6E6E6;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="DominioLecciones"><mxGeo