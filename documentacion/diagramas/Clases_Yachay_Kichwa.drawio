uminate\Database\Eloquent\Model.&lt;br&gt;Los atributos persistidos son propiedades dinámicas.&lt;br&gt;Las operaciones CRUD se heredan de Eloquent;&lt;br&gt;casts() configura las conversiones de tipos.&lt;br&gt;&lt;br&gt;El diccionario es independiente de la jerarquía académica." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="100" y="1250" width="510" height="230" as="geometry"/></mxCell><mxCell id="optional" value="&lt;b&gt;Relaciones opcionales&lt;/b&gt;&lt;br&gt;Una evaluación diagnóstica puede no tener unidad.&lt;br&gt;Actividad.id_tema y EvaluacionKichwa.id_tema&lt;br&gt;son opcionales. Cuando existen, deben respetar&lt;br&gt;la unidad del tema." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="100" y="1600" width="510" height="170" as="geometry"/></mxCell><mxCell id="notes" value="Asociaciones contrastadas con las claves foráneas de las migraciones vigentes. Se usan asociaciones simples: no se supone borrado en cascada ni composición.&lt;br&gt;Los métodos mostrados están declarados en cada clase. No se añaden operaciones de negocio inexistentes a los modelos. Tipos de atributos expresados de forma conceptual." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="2010" width="2040" height="100" as="geometry"/></mxCell><mxCell id="legend" value="UML: + público / atributo dinámico de Eloquent · # protegido · ? tipo nullable · {static} método estático · {oculto} excluido de serialización.&lt;br&gt;Línea: asociación · Triángulo vacío: herencia · Flecha discontinua: dependencia · 1 / 0..1 / 0..*: multiplicidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="2122" width="2040" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="identity" name="02 · Usuarios y progreso"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1950" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagrama de clases · Usuarios y progreso" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=29;fontStyle=1;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="2140" height="46" as="geometry"/></mxCell><mxCell id="subtitle" value="02 / Identidad activa, niveles habilitados, seguimiento por unidad y opiniones" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="91" width="2140" height="46" as="geometry"/></mxCell><mxCell id="Usuario" value="" style="group" vertex="1" parent="1"><mxGeometry x="90" y="300" width="630" height="618" as="geometry"/></mxCell><mxCell id="Usuario-h" value="&lt;font style=&quot;font-size:12px&quot;&gt;«modelo · extends Authenticatable»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Usuario&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#737373;strokeWidth=1.3;fontFamily=Helvetica;fillColor=#E6E6E6;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="Usuario"><mxGeometry x="0" y="0" width="630" height="65" as="geometry"/></mxCell><mxCell id="Usuario-a" value="# table: string = 'usuarios'&lt;br&gt;# primaryKey: string = 'id_usuario'&lt;br&gt;+ timestamps: bool 