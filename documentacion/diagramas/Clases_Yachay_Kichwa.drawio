 source="PublicacionContenido" target="SecuenciaUnidad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="Se muestran las operaciones públicas/protegidas declaradas; los métodos auxiliares privados se omiten. {static} identifica métodos estáticos reales.&lt;br&gt;Dependencias principales extraídas de llamadas entre servicios. Los modelos, Storage, Cache, Validator y DB se omiten como destinos para mantener esta vista legible." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="1890" width="2320" height="100" as="geometry"/></mxCell><mxCell id="legend" value="UML: + público / atributo dinámico de Eloquent · # protegido · ? tipo nullable · {static} método estático · {oculto} excluido de serialización.&lt;br&gt;Línea: asociación · Triángulo vacío: herencia · Flecha discontinua: dependencia · 1 / 0..1 / 0..*: multiplicidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="2002" width="2320" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="controllers" name="05 · Controladores HTTP"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2520" pageHeight="2399" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagrama de clases · Controladores HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=29;fontStyle=1;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="2400" height="46" as="geometry"/></mxCell><mxCell id="subtitle" value="05 / API, autenticación we